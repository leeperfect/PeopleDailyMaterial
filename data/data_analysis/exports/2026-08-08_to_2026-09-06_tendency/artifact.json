        "sql": "SELECT name,impressions,clicks,impression_users,click_users,click_rate FROM search_service_menus WHERE batch_id='2026-08-08_to_2026-09-06_tendency'",
        "description": "按已归档批次读取后台数据，保留原指标口径"
      }
