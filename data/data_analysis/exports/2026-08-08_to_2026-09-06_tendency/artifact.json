  "sources": [
    {
      "id": "daily",
      "label": "后台每日趋势",
      "query": {
        "engine": "SQLite",
        "sql": "SELECT date,published_count,read_users,share_users,wechat_favorites FROM daily_trends WHERE batch_id='2026-08-08_to_2026-09-06_tendency' ORDER BY date",
        "description": "按已归档批次读取后台数据，保留原指标口径"
      }
    },
    {
      "id": "channels",
      "label": "后台渠道阅读",
      "query": {
        "engine": "SQLite",
        "sql": "SELECT channel,CASE WHEN date<'2026-08-30' THEN '前8天' ELSE '新增8天' END period,SUM(read_users) reads FROM channel_daily_reads WHERE batch_id='2026-08-08_to_2026-09-06_tendency' AND date>='2026-08-22' AND channel<>'全部' GROUP BY channel,period",
        "description": "按已归档批次读取后台数据，保留原指标口径"
      }
    },
    {
      "id": "followers",
      "label": "搜索关注来源",
      "query": {
        "engine": "SQLite",
        "sql": "SELECT search_section,CASE WHEN batch_id='2026-08-08_to_2026-09-06_tendency' THEN '本期30天' ELSE '上期30天' END period,impressions,clicks,converted_followers,1.0*converted_followers/clicks conversion FROM search_follower_sources WHERE batch_id IN ('2026-08-08_to_2026-09-06_tendency','2026-07-31_to_2026-08-29_tendency') ORDER BY search_section,period",
        "description": "按已归档批次读取后台数据，保留原指标口径"
      }
    },
    {
      "id": "keywords",
      "label": "热门搜索词",
      "query": {
        "engine": "SQLite",
        "sql": "SELECT keyword,impressions,clicks,click_rate FROM search_keywords WHERE batch_id='2026-08-08_to_2026-09-06_tendency' AND search_section='文章' ORDER BY clicks DESC",
        "description": "按已归档批次读取后台数据，保留原指标口径"
      }
    },
    {
      "id": "articles",
      "label": "热门搜索文章",
      "query": {
        "engine": "SQLite",
        "sql": "SELECT title,impressions,clicks,click_rate,rank_position FROM search_articles WHERE batch_id='2026-08-08_to_2026-09-06_tendency' ORDER BY clicks DESC",
        "description": "按已归档批次读取后台数据，保留原指标口径"
      }
    },
    {
      "id": "menus",
      "label": "热门服务菜单",
      "query": {
