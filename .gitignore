data/core/*.sqlite
data/core/*.sqlite-*
data/core/*.jsonl
data/core/*.json
data/index/fts/
data/index/vector/

# 日志文件
*.log

# IDE文件
.vscode/
.idea/

# 操作系统文件
.DS_Store
Thumbs.db
