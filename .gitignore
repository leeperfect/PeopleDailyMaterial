# 依赖文件
__pycache__/
*.py[cod]
*$py.class
venv/
node_modules/

# 环境文件
.env
.env.local
.env.*.local

# 配置文件（含敏感 Token）
config.json

# 运行时临时数据
data/checkpoints/
logs/
outputs/
.claude/

# 本地生成的核心库与索引（可由脚本重建）
data/core/*.sqlite
data/core/*.sqlite-*
data/core/*.jsonl
data/core/*.json
data/index/fts/
data/index/vector/
data/peopleapp_opinion/core/*.sqlite
data/peopleapp_opinion/core/*.sqlite-*
data/peopleapp_opinion/exports/run_logs/*.log

# 本地多媒体资产（由网盘同步，不进入 GitHub）
media/images/**
media/courseware/**
media/video/**
media/audio/**
media/packages/**
!media/images/.gitkeep
!media/courseware/.gitkeep
!media/video/.gitkeep
!media/audio/.gitkeep
!media/packages/.gitkeep

# 常见非文本成品，默认不入库；用 media/_index.md 记录位置
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg
*.ppt
*.pptx
*.key
*.pdf
*.mp4
*.mov
*.mp3
*.wav
*.m4a
*.zip
*.psd
*.ai

# 日志文件
*.log

# IDE文件
.vscode/
.idea/

# 操作系统文件
.DS_Store
Thumbs.db

# 写作工作流：微信 access_token 缓存（临时凭证，敏感，不入库）
data/exports/wechat_token_cache.json
data/exports/getnote_article_map.json
data/exports/wechat_html/
.local/
