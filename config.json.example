{
  "notion": {
    "token": "YOUR_NOTION_TOKEN",
    "database_id": "YOUR_DATABASE_ID",
    "peopleapp_opinion_database_id": "YOUR_PEOPLEAPP_OPINION_DATABASE_ID"
  },
  "crawler": {
    "base_url": "http://paper.people.com.cn/rmrb/html",
    "request_interval": [1, 3],
    "timeout": 10,
    "max_retries": 3,
    "proxy_enabled": false,
    "proxies": []
  },
  "export": {
    "dir": "data/exports"
  },
  "logging": {
    "level": "INFO",
    "log_file": "crawler.log"
  },
  "writing_workflow_note": "公众号写作工作流的公开配置见 writing_workflow.json；公众号 AppID/AppSecret 仅写入被 Git 忽略的 .env"
}
